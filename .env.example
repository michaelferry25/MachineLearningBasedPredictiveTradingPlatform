# Finnhub API key (free tier: https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# NewsAPI key (free tier: https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# JWT secret for authentication (generate a random 64-char string)
JWT_SECRET=your_jwt_secret_here

# Frontend API URL override (optional, defaults to http://localhost:8080)
# VITE_API_URL=http://localhost:8080
